<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Relatório de regressão · {{ nova.modelo }} · {{ nova.prompt_versao }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #090A0B;
  --surface: #111113;
  --surface-hover: #18191B;
  --surface-elevated: #1A1A1D;
  --border: #1F1F22;
  --border-strong: #2A2A2E;

  --text: #EDEDED;
  --text-body: #D4D4D4;
  --text-muted: #9CA3AF;
  --text-faint: #6B7280;

  --accent: #FF6347;
  --accent-hover: #FF7A62;
  --accent-subtle: rgba(255, 99, 71, 0.12);
  --accent-border: rgba(255, 99, 71, 0.35);

  --ok: #22C55E;
  --aviso: #FBBF24;
  --critico: #F43F5E;

  --serie-base: #4B5563;
  --serie-nova: var(--accent);
  --grid: #1C1C1F;

  --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-display: "Plus Jakarta Sans", "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, "Cascadia Mono", Consolas, "Liberation Mono", monospace;

  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-in: cubic-bezier(0.2, 0, 0, 1);
  --t-micro: 100ms;
  --t-base: 180ms;
  --t-enter: 280ms;

  --radius: 10px;
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text-body);
  font: 400 14px/1.5 var(--font-sans);
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "cv11", "ss01";
}
.num, .mono, td, .kpi-num, .chart-y, .chart-x, .tt { font-variant-numeric: tabular-nums; }
.mono { font-family: var(--font-mono); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
a { color: var(--accent); }

.page { max-width: 1280px; margin: 0 auto; padding: 48px 32px 32px; }
.stack > * + * { margin-top: 16px; }

.overline {
  font-size: 11px; font-weight: 500; letter-spacing: 0.8px; text-transform: uppercase;
  color: var(--text-faint); margin: 0;
}
h1 { font-size: 24px; font-weight: 600; letter-spacing: -0.3px; color: var(--text); margin: 4px 0 0; }
h2 { font-size: 14px; font-weight: 600; color: var(--text); margin: 0; }
.subtle { color: var(--text-muted); }
.faint { color: var(--text-faint); }

.header { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
.header .subtitle { margin: 8px 0 0; color: var(--text-muted); font-size: 13px; }
.header .subtitle .mono { color: var(--text-body); font-size: 12.5px; }
.header-meta { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.chip {
  display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px;
  border: 1px solid var(--border); border-radius: 8px; background: var(--surface);
  font: 400 12px var(--font-mono); color: var(--text-muted);
}
.chip svg { color: var(--text-faint); }
.chip strong { color: var(--text-body); font-weight: 400; }

.verdict {
  display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px;
  border-radius: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.6px;
  border: 1px solid;
}
.verdict--ok { color: var(--ok); background: rgba(34, 197, 94, 0.10); border-color: rgba(34, 197, 94, 0.30); }
.verdict--aviso { color: var(--aviso); background: rgba(251, 191, 36, 0.10); border-color: rgba(251, 191, 36, 0.30); }
.verdict--critico { color: var(--critico); background: rgba(244, 63, 94, 0.10); border-color: rgba(244, 63, 94, 0.32); }

.card {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px;
  transition: border-color var(--t-base) var(--ease), background-color var(--t-base) var(--ease);
  min-width: 0;
}
.card:hover { border-color: var(--border-strong); background: var(--surface-hover); }
.card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
.card-head p { margin: 4px 0 0; font-size: 13px; color: var(--text-faint); }
.count {
  font: 500 11px var(--font-mono); color: var(--text-muted); padding: 2px 8px;
  border: 1px solid var(--border-strong); border-radius: 999px; margin-left: 8px; vertical-align: 1px;
}

.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
.kpi { padding: 20px 24px; display: flex; flex-direction: column; gap: 12px; }
.kpi-value { display: flex; align-items: baseline; gap: 4px; white-space: nowrap; }
.kpi-num { font: 700 36px/1 var(--font-display); letter-spacing: -1px; color: var(--text); font-feature-settings: "tnum"; }
.kpi-affix { font: 600 16px var(--font-display); color: var(--text-faint); letter-spacing: 0; }
.kpi-foot { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 12px; flex-wrap: wrap; }
.delta { font: 500 12px var(--font-mono); white-space: nowrap; }
.delta--bom { color: var(--ok); }
.delta--ruim { color: var(--critico); }
.delta--neutro { color: var(--text-muted); }
.kpi-detail { font: 400 11.5px var(--font-mono); color: var(--text-faint); }

.verdict-card { display: grid; grid-template-columns: 220px 1fr; gap: 24px; align-items: start; }
.verdict-status { display: flex; flex-direction: column; gap: 12px; }
.verdict-status .lead { font-size: 13px; color: var(--text-muted); margin: 0; }
.reasons { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: 8px; }
.reasons li { display: flex; gap: 12px; align-items: flex-start; padding: 12px 16px; font-size: 13px; color: var(--text-body); }
.reasons li + li { border-top: 1px solid var(--border); }
.reasons .lvl { font: 500 10.5px var(--font-mono); letter-spacing: 0.6px; text-transform: uppercase; min-width: 64px; display: inline-flex; gap: 6px; align-items: center; padding-top: 1px; }
.lvl--aviso { color: var(--aviso); }
.lvl--critico { color: var(--critico); }
.lvl--ok { color: var(--ok); }

.empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
  gap: 8px; padding: 32px 16px; border: 1px dashed var(--border-strong); border-radius: 8px; min-height: 160px;
}
.empty-icon {
  width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--border-strong);
  display: grid; place-items: center; color: var(--text-muted); margin-bottom: 4px; background: var(--surface);
}
.empty-icon--ok { color: var(--ok); border-color: rgba(34, 197, 94, 0.30); background: rgba(34, 197, 94, 0.08); }
.empty strong { color: var(--text); font-weight: 500; font-size: 13.5px; }
.empty span { color: var(--text-faint); font-size: 12.5px; max-width: 360px; }

.charts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12px; color: var(--text-muted); }
.legend > span { display: inline-flex; align-items: center; gap: 6px; }
.view .legend { margin-bottom: 16px; }

.seg { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--bg); }
.seg-btn {
  display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border: 0; border-radius: 6px;
  background: transparent; color: var(--text-muted); font: 500 12.5px var(--font-sans); cursor: pointer;
  transition: background-color var(--t-micro) var(--ease), color var(--t-micro) var(--ease);
}
.seg-btn:hover { color: var(--text); }
.seg-btn[aria-selected="true"] { background: var(--surface-elevated); color: var(--accent); box-shadow: inset 0 0 0 1px var(--border-strong); }
.seg-btn .logo { margin-left: -2px; }
.sw { width: 8px; height: 8px; border-radius: 2px; display: inline-block; flex: none; }
.sw--base { background: var(--serie-base); }
.sw--nova { background: var(--serie-nova); }
.sw--neutra { background: var(--text-faint); }
.sw--saida { background: var(--text-faint); opacity: 0.45; }

.logo {
  display: inline-grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 6px;
  color: #FFFFFF;
}
.logo svg { width: 22px; height: 22px; display: block; shape-rendering: geometricPrecision; }
.logo--anthropic { background: #D4A27F; color: #191919; }
.logo--anthropic svg { width: 15px; height: 15px; }
.logo--generico { border: 1px solid var(--border-strong); color: var(--text-muted); }
.logo--generico svg { width: 14px; height: 14px; }
.logo--sm { width: 18px; height: 18px; border-radius: 5px; }
.logo--sm svg { width: 17px; height: 17px; }
.logo--sm.logo--anthropic svg { width: 12px; height: 12px; }
.logo--sm.logo--generico svg { width: 11px; height: 11px; }
.model { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
.model-name { font: 500 13.5px var(--font-sans); color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.model-role { font-size: 12px; color: var(--text-faint); }
.legend .model { gap: 6px; }
.legend .model-name { font-size: 12.5px; color: var(--text-body); }
.subtitle .logo { vertical-align: -4px; margin-right: 2px; }
.subtitle .logo--anthropic { background: none; color: #FFFFFF; }
.subtitle .logo--anthropic svg { width: 15px; height: 15px; }
.sw--dash { width: 14px; height: 0; border-top: 1.5px dashed var(--text-muted); border-radius: 0; }

.chart { display: grid; grid-template-columns: 44px minmax(0, 1fr); grid-template-rows: var(--h, 220px) auto; }
.chart-y { position: relative; font: 400 11px var(--font-mono); color: var(--text-faint); }
.chart-y span { position: absolute; right: 10px; transform: translateY(-50%); white-space: nowrap; }
.chart-plot { position: relative; }
.chart-plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; display: block; }
.chart-x { grid-column: 2; position: relative; height: 32px; font: 400 11px var(--font-mono); color: var(--text-faint); }
.chart-x span { position: absolute; top: 10px; transform: translateX(-50%); white-space: nowrap; }
.chart-x--sans span { font-family: var(--font-sans); font-size: 12px; color: var(--text-muted); }

.grid-line { stroke: var(--grid); stroke-width: 1; }
.grid-line--base { stroke: var(--border-strong); }
.bar { transform-box: fill-box; transform-origin: 50% 100%; animation: grow-y var(--t-enter) var(--ease-in) both; animation-delay: calc(var(--d, 0ms) + var(--i, 0) * 20ms); }
.bar--base { fill: var(--serie-base); }
.bar--nova { fill: var(--serie-nova); }
.hit { fill: transparent; cursor: default; transition: fill var(--t-micro) var(--ease); outline: none; }
.hit:hover, .hit:focus-visible { fill: rgba(255, 255, 255, 0.04); }
.ref { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 4 4; opacity: 0.8; }
.ref-label {
  position: absolute; right: 0; transform: translateY(-100%); padding: 0 0 3px;
  font: 500 10.5px var(--font-mono); color: var(--text-muted); pointer-events: none;
  animation: fade var(--t-enter) var(--ease-in) both; animation-delay: 700ms;
}
.ref-label b { font-weight: 500; color: var(--text); background: var(--surface); padding: 1px 4px; border-radius: 3px; border: 1px solid var(--border); }
.card:hover .ref-label b { background: var(--surface-hover); }

.trend { display: flex; flex-direction: column; }
.trend-title { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin: 0 0 8px 44px; }
.trend-title:not(:first-child) { margin-top: 16px; }
.chart-x--edges span:first-child { transform: translateX(-25%); }
.chart-x--edges span:last-child { transform: translateX(-75%); }
.trend-title .num { font-family: var(--font-mono); color: var(--text); }
.trend-line { fill: none; stroke: var(--serie-nova); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
.line-reveal { animation: reveal 700ms var(--ease) both; animation-delay: var(--d, 0ms); }
.pt { stroke: var(--serie-nova); stroke-width: 8; stroke-linecap: round; fill: none; animation: fade var(--t-base) var(--ease) both; animation-delay: calc(var(--d, 0ms) + 600ms + var(--i, 0) * 30ms); }
.pt-ring { stroke: var(--surface); stroke-width: 16; stroke-linecap: round; fill: none; }
.pt--atual { stroke-width: 12; }
.pt-halo { stroke: color-mix(in srgb, var(--serie-nova) 22%, transparent); stroke-width: 26; stroke-linecap: round; fill: none; animation: fade var(--t-enter) var(--ease) both; animation-delay: calc(var(--d, 0ms) + 900ms); }
.trend-empty { position: absolute; inset: 0; display: grid; place-items: center; font-size: 12px; color: var(--text-faint); }

.tokens { display: flex; flex-direction: column; gap: 20px; padding-top: 4px; }
.tok-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 16px; align-items: center; }
.tok-label { grid-column: 1 / -1; display: flex; gap: 8px; align-items: center; font-size: 12.5px; color: var(--text-muted); min-width: 0; }
.tok-label .mono { color: var(--text-body); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tok-bar { position: relative; height: 28px; }
.tok-bar svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
.tok-anim { transform-origin: 0 50%; animation: grow-x 600ms var(--ease-in) both; animation-delay: var(--d, 0ms); }
.tok { stroke: var(--surface); stroke-width: 2; }
.card:hover .tok { stroke: var(--surface-hover); }
.tok--base { fill: var(--serie-base); }
.tok--nova { fill: var(--serie-nova); }
.tok--saida { fill-opacity: 0.45; }
.tok-total { font: 500 15px var(--font-mono); color: var(--text); text-align: right; min-width: 72px; }
.tok-split { grid-column: 1 / -1; font: 400 11.5px var(--font-mono); color: var(--text-faint); display: flex; gap: 16px; }
.tok-axis { display: flex; justify-content: space-between; font: 400 11px var(--font-mono); color: var(--text-faint); border-top: 1px solid var(--border); padding-top: 8px; }

.table-wrap { overflow: auto; max-height: 560px; border: 1px solid var(--border); border-radius: 8px; }
table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; }
th {
  position: sticky; top: 0; z-index: 1; background: var(--surface); text-align: left;
  font-size: 11px; font-weight: 500; letter-spacing: 0.8px; text-transform: uppercase; color: var(--text-faint);
  padding: 10px 16px; border-bottom: 1px solid var(--border); white-space: nowrap;
}
.card:hover th { background: var(--surface-hover); }
td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; color: var(--text-body); }
tbody tr:last-child td { border-bottom: 0; }
tbody tr { transition: background-color var(--t-micro) var(--ease); }
tbody tr:hover td { background: rgba(255, 255, 255, 0.025); }
td.id { font: 400 12.5px var(--font-mono); color: var(--text-muted); white-space: nowrap; }
td.msg { min-width: 220px; max-width: 340px; color: var(--text); }
td.msg q { quotes: "“" "”"; }
td.sum { min-width: 200px; color: var(--text-muted); }
td.nowrap, th.nowrap { white-space: nowrap; }
td.right, th.right { text-align: right; }
td.data { font: 400 13px var(--font-mono); }

.cat {
  display: inline-flex; align-items: center; height: 22px; padding: 0 8px; border-radius: 999px;
  font: 400 11.5px var(--font-mono); color: var(--text-body); white-space: nowrap;
  background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-strong);
}
.cat--critico { color: var(--critico); background: rgba(244, 63, 94, 0.10); border-color: rgba(244, 63, 94, 0.32); }
.cat--ok { color: var(--ok); background: rgba(34, 197, 94, 0.10); border-color: rgba(34, 197, 94, 0.30); }
.cat--nulo { color: var(--text-faint); border-style: dashed; background: transparent; }
.cat--muted { color: var(--text-muted); }
.shift { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
.shift svg { color: var(--text-faint); flex: none; }

.res { display: inline-flex; align-items: center; gap: 6px; font: 500 12px var(--font-mono); white-space: nowrap; }
.res--ok { color: var(--ok); }
.res--erro { color: var(--critico); }
.nota { font-family: var(--font-mono); color: var(--text); }
.nota small { color: var(--text-faint); font-size: 11px; }

details.card { padding: 0; }
details.card > summary {
  list-style: none; cursor: pointer; padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
  border-radius: var(--radius);
}
details.card > summary::-webkit-details-marker { display: none; }
details.card > summary p { margin: 4px 0 0; font-size: 13px; color: var(--text-faint); }
details.card > summary .chev { color: var(--text-muted); transition: transform var(--t-base) var(--ease); flex: none; }
details.card[open] > summary .chev { transform: rotate(180deg); }
details.card .details-body { padding: 0 24px 24px; }
.row-toggle { cursor: pointer; }
.row-toggle td:last-child svg { color: var(--text-faint); transition: transform var(--t-base) var(--ease); }
.row-toggle[aria-expanded="true"] td:last-child svg { transform: rotate(90deg); color: var(--accent); }
.row-toggle[aria-expanded="true"] td { background: rgba(255, 255, 255, 0.025); border-bottom-color: transparent; }
.row-detail td { background: rgba(255, 255, 255, 0.025); padding: 4px 16px 16px 16px; }
.row-detail dl { margin: 0; display: grid; grid-template-columns: 120px 1fr; gap: 8px 16px; font-size: 13px; padding: 12px 16px; border-left: 2px solid var(--accent-border); }
.row-detail dt { color: var(--text-faint); font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase; padding-top: 2px; }
.row-detail dd { margin: 0; color: var(--text-body); }
.row-detail .err { font: 400 12px var(--font-mono); color: var(--critico); white-space: pre-wrap; word-break: break-word; }

.footer { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); color: var(--text-faint); font-size: 12px; }
.footer dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 24px; margin: 0 0 24px; }
.footer dt { font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase; margin-bottom: 4px; }
.footer dd { margin: 0; font-family: var(--font-mono); color: var(--text-muted); font-size: 12px; line-height: 1.7; }
.footer .gen { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

.tt {
  position: fixed; left: 0; top: 0; z-index: 50; pointer-events: none; min-width: 180px; max-width: 280px;
  background: var(--surface-elevated); border: 1px solid var(--border-strong); border-radius: 8px; padding: 10px 12px;
  opacity: 0; transform: translate3d(var(--x, 0), calc(var(--y, 0) + 4px), 0);
  transition: opacity var(--t-base) var(--ease), transform var(--t-base) var(--ease);
}
.tt.is-visible { opacity: 1; transform: translate3d(var(--x, 0), var(--y, 0), 0); }
.tt-title { font-size: 12px; color: var(--text-muted); margin-bottom: 8px; }
.tt-row { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-body); }
.tt-row .logo { margin-left: -2px; }
.tt-row + .tt-row { margin-top: 4px; }
.tt-row b { margin-left: auto; padding-left: 16px; font: 500 12.5px var(--font-mono); color: var(--text); }

.reveal { animation: fade var(--t-enter) var(--ease-in) both; animation-delay: calc(var(--s, 0) * 60ms); }
@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes grow-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
@keyframes grow-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
@keyframes reveal { from { clip-path: inset(-20px 100% -20px -20px); } to { clip-path: inset(-20px -20px -20px -20px); } }

@media (prefers-reduced-motion: reduce) {
  .bar, .tok-anim, .line-reveal, .pt, .pt-halo, .ref-label { animation: none; }
  .reveal { animation: fade 120ms linear both; animation-delay: 0ms; }
  .tt, .card, .hit, tbody tr { transition: opacity 100ms linear; }
}
</style>
<style>
:root { --serie-base: {{ modelo_base.cor }}; --serie-nova: {{ modelo_nova.cor }}; }

@media (max-width: 960px) {
  .charts { grid-template-columns: minmax(0, 1fr); }
  .verdict-card { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 640px) {
  .page { padding: 32px 16px 24px; }
  .card { padding: 20px 16px; }
  .kpis { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px; }
  .kpi { padding: 16px; }
  .kpi:first-child { grid-column: 1 / -1; }
  .kpi-num { font-size: 28px; }
  .header { align-items: flex-start; }
  .chart { grid-template-columns: 36px minmax(0, 1fr); }
  .trend-title { margin-left: 36px; }
  .chart-x--sans span { font-size: 10.5px; white-space: normal; text-align: center; width: 18%; line-height: 1.2; }
  details.card > summary { padding: 16px; }
  details.card .details-body { padding: 0 16px 16px; }
  .row-detail dl { grid-template-columns: 1fr; }
}
</style>
</head>
{% macro icone(nome, tamanho=14) -%}
<svg width="{{ tamanho }}" height="{{ tamanho }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if nome == "ok" -%}<circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/>
{%- elif nome == "aviso" -%}<path d="M10.3 4.2 2.9 17a2 2 0 0 0 1.7 3h14.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0Z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/>
{%- elif nome == "critico" -%}<path d="M8 2.5h8L21.5 8v8L16 21.5H8L2.5 16V8Z"/><path d="m9.5 9.5 5 5"/><path d="m14.5 9.5-5 5"/>
{%- elif nome == "seta" -%}<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
{%- elif nome == "chevron-down" -%}<path d="m6 9 6 6 6-6"/>
{%- elif nome == "chevron-right" -%}<path d="m9 6 6 6-6 6"/>
{%- elif nome == "relogio" -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif nome == "tendencia" -%}<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>
{%- elif nome == "vazio" -%}<path d="M4 13h4l2 3h4l2-3h4"/><path d="M5.5 6.5 4 13v5a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-5l-1.5-6.5A2 2 0 0 0 16.6 5H7.4a2 2 0 0 0-1.9 1.5Z"/>
{%- endif -%}
</svg>
{%- endmacro %}

{% macro rotulo_status(status) -%}
{{ {"ok": "OK", "aviso": "AVISO", "critico": "CRÍTICO"}[status] }}
{%- endmacro %}

{% macro badge_veredito(status) -%}
<span class="verdict verdict--{{ status }}">{{ icone(status) }}{{ rotulo_status(status) }}</span>
{%- endmacro %}

{% macro badge_categoria(categoria, tom=none) -%}
{% if categoria is none -%}
<span class="cat cat--nulo">inválida</span>
{%- else -%}
<span class="cat{% if tom %} cat--{{ tom }}{% endif %}">{{ categoria }}</span>
{%- endif %}
{%- endmacro %}

{% macro stat_card(kpi, ordem) -%}
<article class="card kpi">
  <p class="overline">{{ kpi.rotulo }}</p>
  <div class="kpi-value">
    {% if kpi.prefixo and kpi.valor is not none %}<span class="kpi-affix">{{ kpi.prefixo }}</span>{% endif %}
    <span class="kpi-num"{% if kpi.valor is not none %} data-count="{{ kpi.valor }}" data-decimals="{{ kpi.casas }}"{% endif %}>{{ kpi.valor_fmt }}</span>
    {% if kpi.sufixo and kpi.valor is not none %}<span class="kpi-affix">{{ kpi.sufixo }}</span>{% endif %}
  </div>
  <div class="kpi-foot">
    {% if kpi.variacao %}
    <span class="delta delta--{{ kpi.variacao.tom }}">{{ kpi.variacao.seta }} {{ kpi.variacao.texto }}</span>
    {% else %}
    <span class="faint">Sem dado anterior</span>
    {% endif %}
    <span class="kpi-detail">{{ kpi.detalhe }}</span>
  </div>
</article>
{%- endmacro %}

{% macro estado_vazio(titulo, descricao, nome_icone="vazio", tom=none) -%}
<div class="empty">
  <div class="empty-icon{% if tom %} empty-icon--{{ tom }}{% endif %}">{{ icone(nome_icone, 18) }}</div>
  <strong>{{ titulo }}</strong>
  <span>{{ descricao }}</span>
</div>
{%- endmacro %}

{% macro logo(provedor, pequeno=false) -%}
<span class="logo logo--{{ provedor.chave }}{% if pequeno %} logo--sm{% endif %}" title="{{ provedor.nome }}"><svg aria-hidden="true"><use href="#logo-{{ provedor.chave }}"/></svg></span>
{%- endmacro %}

{% macro tag_modelo(m, papel=none, pequeno=false) -%}
<span class="model">{{ logo(m.provedor, pequeno) }}<span class="model-name">{{ m.nome }}</span>{% if papel %}<span class="model-role">{{ papel }}</span>{% endif %}</span>
{%- endmacro %}

{% macro legenda(itens) -%}
<div class="legend">
  {% for item in itens %}
  {% if item.modelo is defined %}
  <span><i class="sw sw--{{ item.classe }}"></i>{{ tag_modelo(item.modelo, item.papel, true) }}</span>
  {% else %}
  <span><i class="sw sw--{{ item.classe }}"></i>{{ item.rotulo }}</span>
  {% endif %}
  {% endfor %}
</div>
{%- endmacro %}

{% macro chart_card(titulo, descricao, itens_legenda, secao, abas=none, grupo=none) -%}
<section class="card reveal" style="--s: {{ secao }}; --d: {{ secao * 60 + 120 }}ms">
  <div class="card-head">
    <div>
      <h2>{{ titulo }}</h2>
      <p>{{ descricao }}</p>
    </div>
    {% if abas %}
    <div class="seg" role="tablist" aria-label="{{ titulo }}">
      {% for aba in abas %}
      <button type="button" role="tab" class="seg-btn" id="aba-{{ grupo }}-{{ aba.chave }}" aria-controls="{{ grupo }}-{{ aba.chave }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ 0 if loop.first else -1 }}">
        {% if aba.modelo %}{{ logo(aba.modelo.provedor, true) }}{% endif %}{{ aba.rotulo }}
      </button>
      {% endfor %}
    </div>
    {% else %}
    {{ legenda(itens_legenda) }}
    {% endif %}
  </div>
  {{ caller() }}
</section>
{%- endmacro %}

{% macro eixo_y(ticks) -%}
<div class="chart-y" aria-hidden="true">{% for t in ticks %}<span style="top: {{ '%.2f' % t.pos }}%">{{ t.rotulo }}</span>{% endfor %}</div>
{%- endmacro %}

{% macro linhas_grade(ticks) -%}
{% for t in ticks %}<line class="grid-line{% if loop.first %} grid-line--base{% endif %}" x1="0" x2="100" y1="{{ '%.2f' % t.pos }}" y2="{{ '%.2f' % t.pos }}" vector-effect="non-scaling-stroke"/>{% endfor %}
{%- endmacro %}

{% macro alvos_hover(alvos) -%}
{% for a in alvos %}<rect class="hit" x="{{ '%.3f' % a.x }}" y="-2" width="{{ '%.3f' % a.largura }}" height="104" tabindex="0" data-tip='{{ a.dica.model_dump() | tojson }}'><title>{{ a.dica.titulo }}</title></rect>{% endfor %}
{%- endmacro %}

{% macro grafico_barras(g, altura=220, rotulos_sans=false) -%}
<div class="chart" style="--h: {{ altura }}px">
  {{ eixo_y(g.ticks_y | reverse | list) }}
  <div class="chart-plot">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label="Gráfico de barras">
      {{ linhas_grade(g.ticks_y) }}
      {% for b in g.barras %}<rect class="bar bar--{{ b.serie }}" x="{{ '%.3f' % b.x }}" y="{{ '%.3f' % b.y }}" width="{{ '%.3f' % b.largura }}" height="{{ '%.3f' % b.altura }}" style="--i: {{ b.indice }}"/>{% endfor %}
      {% for r in g.linhas_ref %}<line class="ref" x1="0" x2="100" y1="{{ '%.3f' % r.y }}" y2="{{ '%.3f' % r.y }}" vector-effect="non-scaling-stroke"/>{% endfor %}
      {{ alvos_hover(g.alvos) }}
    </svg>
    {% for r in g.linhas_ref %}<span class="ref-label" style="top: {{ '%.3f' % r.y }}%"><b>{{ r.rotulo }}</b></span>{% endfor %}
  </div>
  <div class="chart-x{% if rotulos_sans %} chart-x--sans{% endif %}" aria-hidden="true">{% for t in g.rotulos_x %}<span style="left: {{ '%.3f' % t.pos }}%">{{ t.rotulo }}</span>{% endfor %}</div>
</div>
{%- endmacro %}

{% macro tabela_mudancas(linhas, tom) -%}
<div class="table-wrap">
  <table>
    <thead>
      <tr><th>Caso</th><th>Mensagem do contato</th><th>Esperada</th><th>Antes → depois</th><th>Resumo (nova)</th></tr>
    </thead>
    <tbody>
      {% for l in linhas %}
      <tr>
        <td class="id">{{ l.id_caso }}</td>
        <td class="msg"><q>{{ l.mensagem }}</q></td>
        <td>{{ badge_categoria(l.esperada) }}</td>
        <td><span class="shift">{{ badge_categoria(l.antes, "muted") }}{{ icone("seta", 12) }}{{ badge_categoria(l.depois, tom) }}</span></td>
        <td class="sum">{{ l.resumo if l.resumo else "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

<body>
