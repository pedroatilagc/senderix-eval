<main class="page">

  <header class="header reveal" style="--s: 0">
    <div>
      <p class="overline">Senderix eval</p>
      <h1>Relatório de regressão</h1>
      <p class="subtitle">
        {{ logo(modelo_nova.provedor, true) }} <span class="mono">{{ nova.modelo }}</span> · prompt <span class="mono">{{ nova.prompt_versao }}</span>
        · dataset <span class="mono">{{ nova.dataset_versao }}</span>
        · comparado com {{ logo(modelo_base.provedor, true) }} <span class="mono">{{ rotulo_base }}</span>
      </p>
    </div>
    <div class="header-meta">
      <span class="chip">{{ icone("relogio", 13) }}<strong>{{ data_base }}</strong> → <strong>{{ data_nova }}</strong></span>
      {{ badge_veredito(veredito.status) }}
    </div>
  </header>

  <div class="stack">

    <section class="kpis reveal" style="--s: 1" aria-label="Indicadores da execução nova">
      {% for kpi in kpis %}{{ stat_card(kpi, loop.index0) }}{% endfor %}
    </section>

    <section class="card verdict-card reveal" style="--s: 2">
      <div class="verdict-status">
        <p class="overline">Veredito</p>
        <div>{{ badge_veredito(veredito.status) }}</div>
        <p class="lead">
          {% if veredito.status == "ok" %}A execução nova está dentro dos limiares definidos.
          {% elif veredito.status == "aviso" %}Mudanças que merecem revisão antes de promover.
          {% else %}Regressão acima do limiar crítico. Não promova esta configuração.
          {% endif %}
        </p>
      </div>
      {% if motivos %}
      <ul class="reasons">
        {% for m in motivos %}
        <li><span class="lvl lvl--{{ m.nivel }}">{{ icone(m.nivel, 12) }}{{ m.nivel }}</span><span>{{ m.texto }}</span></li>
        {% endfor %}
      </ul>
      {% else %}
      {{ estado_vazio("Nenhuma regressão acima dos limiares",
                      "Taxa de acerto, nota do resumo e categorias críticas ficaram dentro do esperado.", "ok", "ok") }}
      {% endif %}
    </section>

    <div class="charts">
      {% call chart_card("Acurácia por categoria", "Percentual de acerto por categoria esperada",
                         [dict(modelo=modelo_base, classe="base", papel="base"), dict(modelo=modelo_nova, classe="nova", papel="nova")], 3) %}
        {{ grafico_barras(grafico_categorias, 240, true) }}
      {% endcall %}

      {% call chart_card("Tendência", ("Últimas " ~ tendencia.quantidade ~ " execuções" if tendencia.quantidade > 1 else "Execuções") ~ " de " ~ nova.modelo ~ " no dataset " ~ nova.dataset_versao,
                         [dict(modelo=modelo_nova, classe="nova")], 3) %}
        {% if tendencia.quantidade < 2 %}
          {{ estado_vazio("Ainda não há tendência",
                          "A tendência aparece a partir da segunda execução deste modelo no mesmo dataset.", "tendencia") }}
        {% else %}
        <div class="trend">
          {% for p in tendencia.paineis %}
          <div class="trend-title">
            <span>{{ p.titulo }}</span>
          </div>
          <div class="chart" style="--h: 96px">
            {{ eixo_y(p.ticks_y) }}
            <div class="chart-plot">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">{{ linhas_grade(p.ticks_y) }}</svg>
              {% if p.vazio %}
              <div class="trend-empty">{{ p.vazio }}</div>
              {% else %}
              <svg class="line-reveal" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <polyline class="trend-line" points="{{ p.trajeto }}" vector-effect="non-scaling-stroke"/>
              </svg>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                {% for pt in p.pontos %}
                {% set d = "M%.3f %.3fh0" % (pt.x, pt.y) %}
                {% if pt.atual %}<path class="pt-halo" d="{{ d }}" vector-effect="non-scaling-stroke"/>{% endif %}
                <path class="pt-ring" d="{{ d }}" vector-effect="non-scaling-stroke"/>
                <path class="pt{% if pt.atual %} pt--atual{% endif %}" d="{{ d }}" style="--i: {{ loop.index0 }}" vector-effect="non-scaling-stroke"/>
                {% endfor %}
              </svg>
              {% endif %}
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" role="img" aria-label="{{ p.titulo }}">{{ alvos_hover(p.alvos) }}</svg>
            </div>
          </div>
          {% endfor %}
          <div class="chart" style="--h: 0px">
            <div></div>
            <div class="chart-x chart-x--edges" aria-hidden="true">{% for t in tendencia.rotulos_x %}{% if loop.first or loop.last or tendencia.quantidade <= 5 %}<span style="left: {{ '%.3f' % t.pos }}%">{{ t.rotulo }}</span>{% endif %}{% endfor %}</div>
          </div>
        </div>
        {% endif %}
      {% endcall %}

      {% call chart_card("Latência por caso", "Um caso por barra, mesma escala nas três visões", [], 4, abas=visoes_latencia, grupo="latencia") %}
        {% for v in visoes_latencia %}
        <div class="view" id="latencia-{{ v.chave }}" role="tabpanel" aria-labelledby="aba-latencia-{{ v.chave }}"{% if not loop.first %} hidden{% endif %}>
          {% if v.modelo %}
          {{ legenda([dict(modelo=v.modelo, classe=v.chave, papel=v.chave), dict(rotulo="P50 / P95", classe="dash")]) }}
          {% else %}
          {{ legenda([dict(modelo=modelo_base, classe="base", papel="base"), dict(modelo=modelo_nova, classe="nova", papel="nova")]) }}
          {% endif %}
          {{ grafico_barras(v.grafico, 240) }}
        </div>
        {% endfor %}
      {% endcall %}

      {% call chart_card("Tokens", "Volume total de entrada e saída por execução",
                         [dict(modelo=modelo_base, classe="base", papel="base"), dict(modelo=modelo_nova, classe="nova", papel="nova"), dict(rotulo="Saída", classe="saida")], 4) %}
        <div class="tokens">
          {% for linha in tokens %}
          <div class="tok-row">
            <div class="tok-label"><i class="sw sw--{{ linha.serie }}"></i>{{ tag_modelo(linha.modelo, linha.serie ~ " · " ~ linha.modelo.prompt_versao) }}</div>
            <div class="tok-bar">
              <svg viewBox="0 0 100 10" preserveAspectRatio="none" class="tok-anim" style="--d: {{ 420 + loop.index0 * 80 }}ms">
                {% for s in linha.segmentos %}
                <rect class="tok tok--{{ linha.serie }} tok--{{ s.tipo }} hit-tok" x="{{ '%.3f' % s.x }}" y="0" width="{{ '%.3f' % ([s.largura, 0.4] | max) }}" height="10" vector-effect="non-scaling-stroke" tabindex="0" data-tip='{{ s.dica.model_dump() | tojson }}'/>
                {% endfor %}
              </svg>
            </div>
            <div class="tok-total">{{ linha.total_fmt }}</div>
            <div class="tok-split">
              {% for s in linha.segmentos %}<span>{{ "entrada" if s.tipo == "entrada" else "saída" }} {{ s.dica.linhas[loop.index0].valor }}</span>{% endfor %}
            </div>
          </div>
          {% endfor %}
          <div class="tok-axis"><span>0</span><span>tokens</span></div>
        </div>
      {% endcall %}
    </div>

    <section class="card reveal" style="--s: 5">
      <div class="card-head">
        <div>
          <h2>Regressões<span class="count">{{ regressoes | length }}</span></h2>
          <p>Casos que a base acertava e a execução nova errou</p>
        </div>
      </div>
      {% if regressoes %}
        {{ tabela_mudancas(regressoes, "critico") }}
      {% else %}
        {{ estado_vazio("Nenhuma regressão",
                        "Todos os casos que a base acertava continuam corretos na execução nova.", "ok", "ok") }}
      {% endif %}
    </section>

    <section class="card reveal" style="--s: 6">
      <div class="card-head">
        <div>
          <h2>Melhorias<span class="count">{{ melhorias | length }}</span></h2>
          <p>Casos que a base errava e a execução nova acertou</p>
        </div>
      </div>
      {% if melhorias %}
        {{ tabela_mudancas(melhorias, "ok") }}
      {% else %}
        {{ estado_vazio("Nenhuma melhoria",
                        "A execução nova não corrigiu nenhum caso que a base errava.") }}
      {% endif %}
    </section>

    <details class="card reveal" style="--s: 7">
      <summary>
        <div>
          <h2>Todos os casos<span class="count">{{ acertos_nova }}/{{ casos | length }}</span></h2>
          <p>Detalhe da execução nova. Clique em uma linha para ver o resumo e a justificativa do juiz.</p>
        </div>
        <span class="chev">{{ icone("chevron-down", 18) }}</span>
      </summary>
      <div class="details-body">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Caso</th><th>Mensagem</th><th>Esperada</th><th>Obtida</th><th>Resultado</th>
                <th class="right">Nota</th><th class="right">Latência</th><th class="right">Custo (US$)</th><th aria-label="Expandir"></th>
              </tr>
            </thead>
            <tbody>
              {% for c in casos %}
              <tr class="row-toggle" tabindex="0" aria-expanded="false" aria-controls="det-{{ loop.index }}">
                <td class="id">{{ c.id_caso }}</td>
                <td class="msg"><q>{{ c.mensagem }}</q></td>
                <td>{{ badge_categoria(c.esperada) }}</td>
                <td>{{ badge_categoria(c.obtida, none if c.acertou else "critico") }}</td>
                <td>
                  {% if c.acertou %}<span class="res res--ok">{{ icone("ok", 13) }}acertou</span>
                  {% else %}<span class="res res--erro">{{ icone("critico", 13) }}{{ "errou" if c.formato_valido else "formato" }}</span>{% endif %}
                </td>
                <td class="right nota">{% if c.nota is not none %}{{ c.nota }}<small>/5</small>{% else %}<span class="faint">—</span>{% endif %}</td>
                <td class="right data nowrap">{{ c.latencia_fmt }}</td>
                <td class="right data">{{ c.custo_fmt }}</td>
                <td>{{ icone("chevron-right", 14) }}</td>
              </tr>
              <tr class="row-detail" id="det-{{ loop.index }}" hidden>
                <td colspan="9">
                  <dl>
                    <dt>Resumo</dt><dd>{{ c.resumo if c.resumo else "—" }}</dd>
                    <dt>Juiz</dt><dd>{{ c.justificativa if c.justificativa else "Sem avaliação do juiz nesta execução." }}</dd>
                    {% if c.erro %}<dt>Erro</dt><dd class="err">{{ c.erro }}</dd>{% endif %}
                  </dl>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </details>
  </div>

  <footer class="footer">
    <dl>
      <div><dt>Dataset</dt><dd>golden_{{ nova.dataset_versao }} · {{ dataset.casos | length }} casos<br>criado em {{ dataset.criado_em }}</dd></div>
      <div><dt>Base</dt><dd>{{ tag_modelo(modelo_base, none, true) }}<br>prompt {{ base.prompt_versao }} · {{ base.executado_em }}</dd></div>
      <div><dt>Nova</dt><dd>{{ tag_modelo(modelo_nova, none, true) }}<br>prompt {{ nova.prompt_versao }} · {{ nova.executado_em }}</dd></div>
      <div>
        <dt>Limiares</dt>
        <dd>
          aviso ≥ {{ limiares.queda_aviso_pp | fmt }} pp · crítico ≥ {{ limiares.queda_critico_pp | fmt }} pp<br>
          queda da nota ≥ {{ limiares.queda_nota_resumo_aviso | fmt(2) }}<br>
          categorias críticas: {{ limiares.categorias_criticas | join(", ") if limiares.categorias_criticas else "nenhuma" }}
        </dd>
      </div>
    </dl>
    <div class="gen">
      <span>Latência P95 nova: {{ metricas_nova.latencia_p95 | fmt(0) }} ms{% if custo_juiz_fmt %} · custo do juiz: US$ {{ custo_juiz_fmt }}{% endif %}</span>
      <span>Gerado em {{ gerado_em }}</span>
    </div>
  </footer>
</main>

<div class="tt" role="tooltip" aria-hidden="true"></div>

<script>
(function () {
  "use strict";
  var reduz = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll("[data-count]").forEach(function (el) {
    var alvo = parseFloat(el.dataset.count);
    var casas = parseInt(el.dataset.decimals, 10) || 0;
    var formato = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: casas, maximumFractionDigits: casas });
    if (reduz || !isFinite(alvo)) { el.textContent = formato.format(alvo); return; }
    var inicio = null, duracao = 600;
    function passo(t) {
      if (inicio === null) inicio = t;
      var p = Math.min((t - inicio) / duracao, 1);
      el.textContent = formato.format(alvo * (1 - Math.pow(1 - p, 3)));
      if (p < 1) requestAnimationFrame(passo);
    }
    el.textContent = formato.format(0);
    setTimeout(function () { requestAnimationFrame(passo); }, 120);
  });

  var tt = document.querySelector(".tt");
  var atual = null;
  var SVG = "http://www.w3.org/2000/svg";
  function logo(chave) {
    var caixa = document.createElement("span");
    caixa.className = "logo logo--sm logo--" + chave;
    var svg = document.createElementNS(SVG, "svg");
    var uso = document.createElementNS(SVG, "use");
    uso.setAttribute("href", "#logo-" + chave);
    svg.appendChild(uso);
    caixa.appendChild(svg);
    return caixa;
  }
  function preencher(dados) {
    tt.textContent = "";
    var titulo = document.createElement("div");
    titulo.className = "tt-title";
    titulo.textContent = dados.titulo;
    tt.appendChild(titulo);
    dados.linhas.forEach(function (l) {
      var linha = document.createElement("div");
      linha.className = "tt-row";
      var sw = document.createElement("i");
      sw.className = "sw sw--" + l.serie;
      var rotulo = document.createElement("span");
      rotulo.textContent = l.rotulo;
      var valor = document.createElement("b");
      valor.textContent = l.valor;
      linha.append(sw);
      if (l.provedor) linha.append(logo(l.provedor));
      linha.append(rotulo, valor);
      tt.appendChild(linha);
    });
  }
  function posicionar(x, y) {
    var w = tt.offsetWidth, h = tt.offsetHeight, m = 12;
    var px = x + 14, py = y + 14;
    if (px + w + m > window.innerWidth) px = x - w - 14;
    if (py + h + m > window.innerHeight) py = y - h - 14;
    tt.style.setProperty("--x", Math.max(m, px) + "px");
    tt.style.setProperty("--y", Math.max(m, py) + "px");
  }
  function mostrar(el, x, y) {
    if (atual !== el) {
      try { preencher(JSON.parse(el.getAttribute("data-tip"))); } catch (e) { return; }
      atual = el;
    }
    posicionar(x, y);
    tt.classList.add("is-visible");
  }
  function esconder() { atual = null; tt.classList.remove("is-visible"); }

  document.addEventListener("pointermove", function (ev) {
    var el = ev.target.closest && ev.target.closest("[data-tip]");
    if (el) mostrar(el, ev.clientX, ev.clientY); else if (atual) esconder();
  });
  document.addEventListener("focusin", function (ev) {
    var el = ev.target.closest && ev.target.closest("[data-tip]");
    if (!el) return;
    var r = el.getBoundingClientRect();
    mostrar(el, r.left + r.width / 2, r.top);
  });
  document.addEventListener("focusout", esconder);
  window.addEventListener("scroll", esconder, { passive: true });

  document.querySelectorAll("[role=tablist]").forEach(function (lista) {
    var abas = Array.prototype.slice.call(lista.querySelectorAll("[role=tab]"));
    function selecionar(aba) {
      abas.forEach(function (outra) {
        var ativa = outra === aba;
        outra.setAttribute("aria-selected", String(ativa));
        outra.tabIndex = ativa ? 0 : -1;
        document.getElementById(outra.getAttribute("aria-controls")).hidden = !ativa;
      });
      esconder();
    }
    abas.forEach(function (aba, i) {
      aba.addEventListener("click", function () { selecionar(aba); });
      aba.addEventListener("keydown", function (ev) {
        var passo = ev.key === "ArrowRight" ? 1 : ev.key === "ArrowLeft" ? -1 : 0;
        if (!passo) return;
        ev.preventDefault();
        var proxima = abas[(i + passo + abas.length) % abas.length];
        proxima.focus();
        selecionar(proxima);
      });
    });
  });

  function alternar(linha) {
    var detalhe = document.getElementById(linha.getAttribute("aria-controls"));
    var aberta = linha.getAttribute("aria-expanded") === "true";
    linha.setAttribute("aria-expanded", String(!aberta));
    detalhe.hidden = aberta;
  }
  document.querySelectorAll(".row-toggle").forEach(function (linha) {
    linha.addEventListener("click", function () { alternar(linha); });
    linha.addEventListener("keydown", function (ev) {
      if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); alternar(linha); }
    });
  });
})();
</script>
</body>
</html>
